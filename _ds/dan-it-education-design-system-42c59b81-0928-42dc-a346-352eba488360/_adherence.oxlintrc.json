{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/marketing-website/sections/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Golos Text|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Golos Text, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItemData'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|answer|defaultOpen|icon|key|ref|className|style|children)$/]",
        "message": "<AccordionItemData> doesn't accept that prop. Declared props: question, answer, defaultOpen, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|tag|title|key|ref|className|style|children)$/]",
        "message": "<ArticleCard> doesn't accept that prop. Declared props: image, tag, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarGroupItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|initials|key|ref|className|style|children)$/]",
        "message": "<AvatarGroupItem> doesn't accept that prop. Declared props: src, alt, initials."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|purple|lilac|yellow|mint|sky|outline)$/]",
        "message": "<Badge> tone must be one of 'dark' | 'purple' | 'lilac' | 'yellow' | 'mint' | 'sky' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|as|icon|iconPosition|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, as, icon, iconPosition, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|purple|text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'purple' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselControls'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|active|onPrev|onNext|onDot|key|ref|className|style|children)$/]",
        "message": "<CarouselControls> doesn't accept that prop. Declared props: count, active, onPrev, onNext, onDot."
      },
      {
        "selector": "JSXOpeningElement[name.name='CourseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:startDate|duration|categoryTag|title|aiTools|description|ctaLabel|onCtaClick|key|ref|className|style|children)$/]",
        "message": "<CourseCard> doesn't accept that prop. Declared props: startDate, duration, categoryTag, title, aiTools, description, ctaLabel, onCtaClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|key|ref|className|style|children)$/]",
        "message": "<EventBadge> doesn't accept that prop. Declared props: label, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventBadge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|purple|lilac|yellow|mint|sky|outline)$/]",
        "message": "<EventBadge> tone must be one of 'dark' | 'purple' | 'lilac' | 'yellow' | 'mint' | 'sky' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|title|description|key|ref|className|style|children)$/]",
        "message": "<FormatCard> doesn't accept that prop. Declared props: icon, tone, title, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:lilac|mint|sky|yellow)$/]",
        "message": "<FormatCard> tone must be one of 'lilac' | 'mint' | 'sky' | 'yellow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<IconCircle> doesn't accept that prop. Declared props: children, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCircle'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|on-purple|light)$/]",
        "message": "<IconCircle> tone must be one of 'dark' | 'on-purple' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|type|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: placeholder, type, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoStripLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|key|ref|className|style|children)$/]",
        "message": "<LogoStripLogo> doesn't accept that prop. Declared props: name, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='Navbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|phone|phoneNote|links|lang|key|ref|className|style|children)$/]",
        "message": "<Navbar> doesn't accept that prop. Declared props: logo, phone, phoneNote, links, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhoneInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|countryCode|flag|style|key|ref|className|style|children)$/]",
        "message": "<PhoneInput> doesn't accept that prop. Declared props: value, onChange, countryCode, flag, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|pill|title|description|highlighted|key|ref|className|style|children)$/]",
        "message": "<StepCard> doesn't accept that prop. Declared props: icon, pill, title, description, highlighted."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|trailing|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, value, onChange, trailing."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:photo|tone|quote|body|name|role|ctaLabel|key|ref|className|style|children)$/]",
        "message": "<TestimonialCard> doesn't accept that prop. Declared props: photo, tone, quote, body, name, role, ctaLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:mint|lilac|sky|yellow)$/]",
        "message": "<TestimonialCard> tone must be one of 'mint' | 'lilac' | 'sky' | 'yellow'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
